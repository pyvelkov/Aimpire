PORT=3000
HOST=127.0.0.1

# Supabase service role. Server only. Never expose this to the dashboard or browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# The immutable Supabase Auth user id of the single dashboard owner.
DASHBOARD_OWNER_USER_ID=


# Optional decision thresholds
PRODUCT_DECISION_MIN_CONTRIBUTION_AFTER_ADS=
PRODUCT_DECISION_MIN_MARGIN_PERCENT=

# Set to true only when the process must listen on a private network interface.
# Write and operational routes still reject non-loopback clients.
ALLOW_NON_LOOPBACK_BIND=

# Task scheduler. Disabled and dry-run by default. Stage 7.1 does not claim or execute tasks.
SCHEDULER_ENABLED=false
SCHEDULER_DRY_RUN=true
SCHEDULER_POLL_INTERVAL_MS=30000
SCHEDULER_MAX_CONCURRENT_TASKS=1
SCHEDULER_MAX_CLAIMS_PER_CYCLE=1
SCHEDULER_LEASE_SECONDS=120
SCHEDULER_SUPPORTED_AGENT_TYPES=research
